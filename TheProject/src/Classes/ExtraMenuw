// ─────────────────────────────────────────────
//  Begin
// ─────────────────────────────────────────────
void Extra::Begin()
{
    SlectedString = &menuItems;
    MenuIdFocus = mainOS->InExtraMenuID;
    targetCameraY = MenuIdFocus * DistanceBetweenTXT;
}

// ─────────────────────────────────────────────
//  Loop
// ─────────────────────────────────────────────
void Extra::Loop()
{
    if (mainOS->NewKey.ifKeyJustPress('`'))
    {
        mainOS->ChangeMenu(new MainMenuV2(mainOS));
        return;
    }
    if (mainOS->screenOff)
        return;

    // ── מקש I: פתח/סגור מסך מידע ──

    if (M5Cardputer.Keyboard.isKeyPressed('i'))
    {
        showingInfo = true;
    }
    else
    {
        showingInfo = false;
    }
    // ── אם מסך מידע פתוח — רק מציגים אותו, לא מזיזים תפריט ──
    if (showingInfo)
    {
        DrawInfo();
        return;
    }

    // ── ניווט תפריט ──
    if (mainOS->NewKey.ifKeyJustPress('.'))
    {
        MenuIdFocus++;
        if (MenuIdFocus > (int)SlectedString->size() - 1)
            MenuIdFocus = 0;
        mainOS->InExtraMenuID = MenuIdFocus;
        targetCameraY = MenuIdFocus * DistanceBetweenTXT;
    }
    if (mainOS->NewKey.ifKeyJustPress(';'))
    {
        MenuIdFocus--;
        if (MenuIdFocus < 0)
            MenuIdFocus = SlectedString->size() - 1;
        mainOS->InExtraMenuID = MenuIdFocus;
        targetCameraY = MenuIdFocus * DistanceBetweenTXT;
    }

    // ── ENTER: פתח פריט ──
    if (mainOS->NewKey.ifKeyJustPress(KEY_ENTER))
    {
        if ((*SlectedString)[MenuIdFocus] == "Step's Counter")
            mainOS->ChangeMenu(new StepCounter(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Timer")
            mainOS->ChangeMenu(new Timer(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "GPIO Control")
            mainOS->ChangeMenu(new GPIOcontrol(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Calculator")
            mainOS->ChangeMenu(new Calculator(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "MIC Record to SD Card")
        {
            mainOS->SetFastBootVar(6);
            ESP.restart();
            mainOS->ChangeMenu(new RecordV2(mainOS));
        }
        else if ((*SlectedString)[MenuIdFocus] == "WIFI")
            mainOS->ChangeMenu(new Wifi_handle(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Password Vault")
            mainOS->ChangeMenu(new PasswordVault(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Esp Projects Remote Control")
        {
#if defined(COMPILE_WIFI_THINGS)
            mainOS->ChangeMenu(new EspProjectRemoteControl(mainOS));
#endif
        }
        else if ((*SlectedString)[MenuIdFocus] == "emulator")
        {
            mainOS->SetFastBootVar(5);
            ESP.restart();
#if defined(COMPILE_EMULATOR)
            mainOS->ChangeMenu(new Emulator(mainOS));
#endif
        }
        else if ((*SlectedString)[MenuIdFocus] == "Color Picker")
            mainOS->ChangeMenu(new ColorPicker(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "ESPnow Chat")
            mainOS->ChangeMenu(new ESPnowChat(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Wifi Spectrum")
            mainOS->ChangeMenu(new wifiSpectrum(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Theme Manager")
            mainOS->ChangeMenu(new Theme_Maneger(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Painter")
        {
            mainOS->ChangeMenu(new Painter(mainOS));
            return;
        }
        else if ((*SlectedString)[MenuIdFocus] == "(NOT) AI Chatbot (not Work Well)")
        {
            mainOS->SetFastBootVar(3);
            ESP.restart();
        }
        else if ((*SlectedString)[MenuIdFocus] == "Partition Viewer")
            mainOS->ChangeMenu(new partition_maneger(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "GameV2")
            mainOS->ChangeMenu(new GamesV2(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Snake")
            mainOS->ChangeMenu(new Snake(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Piano")
            mainOS->ChangeMenu(new Piano(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Music Creator")
            mainOS->ChangeMenu(new MusicCreator(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Wake Me Up (Alarm Clock)")
            mainOS->ChangeMenu(new AlarmClock(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Create New Infrared File")
        {
            mainOS->FileSelectedInFS = "";
            mainOS->ChangeMenu(new IR_Editor(mainOS));
        }
        else if ((*SlectedString)[MenuIdFocus] == "Loan Calculator")
            mainOS->ChangeMenu(new LoanCalculator(mainOS));
        else if ((*SlectedString)[MenuIdFocus] == "Unit AudioPlayer N9301")
            mainOS->ChangeMenu(new UnitAudioPlayerController(mainOS));
    }



    
    cameraY = cameraY + (targetCameraY - cameraY) * 0.12f;

    if (!mainOS->screenOff)
        Draw();
}

// ─────────────────────────────────────────────
//  Draw — תפריט רגיל
// ─────────────────────────────────────────────
void Extra::Draw()
{
    const int HEADER_H   = 18;
    const int MENU_X     = 35;
    const int PIC_X      = 11;
    const int PIC_Y_OFF  = -1;

    int y = HEADER_H + 6 - (int)cameraY;

    mainOS->sprite.createSprite(240, 135 - TopOffset);
    mainOS->sprite.fillScreen(0x0841); // כהה כחלחל
    mainOS->sprite.unloadFont();
    mainOS->sprite.setTextSize(1);
    mainOS->sprite.setTextWrap(false);

    /* ── פריטי תפריט ── */
    for (int i = 0; i < (int)SlectedString->size(); i++)
    {
        if (MenuIdFocus == i)
        {
            // פס ירוק שמאלי + רקע הדגשה
            mainOS->sprite.fillRect(0,  y - 2, 3,   DistanceBetweenTXT, TFT_GREEN);
            mainOS->sprite.fillRect(3,  y - 2, 237, DistanceBetweenTXT, 0x1082);
            mainOS->sprite.setTextColor(TFT_GREEN);
        }
        else
        {
            mainOS->sprite.setTextColor(YELLOW);
        }

        // קו מפריד בין פריטים
        mainOS->sprite.drawFastHLine(0, y - 3, 240, 0x2104);

        // אייקונים
        switch (i)
        {
        case 0:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, remote);       break;
        case 1:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, vault);        break;
        case 2:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, Steps);        break;
        case 3:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, colorPallete); break;
        case 4:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, timer);        break;
        case 5:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, calculator);   break;
        case 6:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, theme);        break;
        case 7:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, gpio);         break;
        case 8:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, RecordMic);    break;
        case 9:  mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, partition);    break;
        case 10: mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, WifiSpectrum); break;
        case 11: mainOS->sprite.pushImage(PIC_X, y + PIC_Y_OFF, 24, 24, alarmClockIcon); break;
        default: break;
        }

        mainOS->sprite.setCursor(MENU_X, y);
        mainOS->sprite.print((*SlectedString)[i]);

        y += DistanceBetweenTXT;
    }

    /* ── כותרת ── */
    mainOS->sprite.fillRect(0, 0, 240, HEADER_H, 0x1082);
    mainOS->sprite.drawFastHLine(0, HEADER_H, 240, TFT_DARKGREEN); // קו ירוק תחת כותרת

    mainOS->sprite.setTextColor(WHITE);
    mainOS->sprite.setCursor(6, 5);
    mainOS->sprite.print("EXTRA MENU");

    // רמז מקש I — בצד ימין של הכותרת
    mainOS->sprite.setTextColor(TFT_DARKGREY);
    mainOS->sprite.setCursor(150, 5);
    mainOS->sprite.print("[ I ] = info");

    mainOS->sprite.pushSprite(0, TopOffset);
    mainOS->sprite.deleteSprite();
}

// ─────────────────────────────────────────────
//  DrawInfo — מסך תיאור הפריט הנבחר
// ─────────────────────────────────────────────
void Extra::DrawInfo()
{
    String name = (*SlectedString)[MenuIdFocus];
    String desc = GetDescription(name);

    mainOS->sprite.createSprite(240, 135 - TopOffset);
    mainOS->sprite.fillScreen(0x0841);

    // ── כותרת ──
    mainOS->sprite.fillRect(0, 0, 240, 18, 0x1082);
    mainOS->sprite.drawFastHLine(0, 18, 240, TFT_DARKGREEN);
    mainOS->sprite.setTextColor(TFT_GREEN);
    mainOS->sprite.setCursor(6, 5);
    mainOS->sprite.print(name);

    // ── תיאור ──
    mainOS->sprite.setTextColor(TFT_LIGHTGREY);
    mainOS->sprite.setTextWrap(true);
    mainOS->sprite.setCursor(8, 26);
    mainOS->sprite.print(desc);

    // ── רמז סגירה ──
    mainOS->sprite.drawFastHLine(0, 110, 240, 0x2104);
    mainOS->sprite.setTextColor(TFT_DARKGREY);
    mainOS->sprite.setCursor(6, 114);
    mainOS->sprite.print("Press [ I ] to close");

    mainOS->sprite.pushSprite(0, 0);
    mainOS->sprite.deleteSprite();
}